{
  "_version": "1.65.0",
  "sap.app": {
    "id": "dn.translations",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/translator/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "TestResult-manage": {
          "semanticObject": "TestResult",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://translate",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://translate"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "dn.translations.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TestResultsList",
          "target": "TestResultsList"
        },
        {
          "pattern": "TestResults({key}):?query:",
          "name": "TestResultsObjectPage",
          "target": "TestResultsObjectPage"
        }
      ],
      "targets": {
        "TestResultsList": {
          "type": "Component",
          "id": "TestResultsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/TestResults",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "TestResults": {
                  "detail": {
                    "route": "TestResultsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "All",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#All"
                  },
                  {
                    "key": "Success",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Success"
                  },
                  {
                    "key": "Partial",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Partial"
                  },
                  {
                    "key": "Failed",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Failed"
                  }
                ],
                "showCounts": true
              }
            }
          }
        },
        "TestResultsObjectPage": {
          "type": "Component",
          "id": "TestResultsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/TestResults",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "plmtranslatorcap.service"
  }
}