{
  "name": "plm-translator-cap",
  "version": "1.0.0",
  "description": "DN Translator - SAP CAP (Node.js) application for label translation using Google Cloud Translation API",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy:db": "cds deploy --to sqlite",
    "build:cf": "mbt build",
    "deploy:cf": "cf deploy mta_archives/plm-translator-cap_1.0.0.mtar"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@google-cloud/translate": "^10.1.1",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap/cds": "^10.2.1",
    "@sap/xssec": "^4",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10.2.0",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^10"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "sqlite3": true,
    "better-sqlite3": true
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "data/plm_translator.db"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
