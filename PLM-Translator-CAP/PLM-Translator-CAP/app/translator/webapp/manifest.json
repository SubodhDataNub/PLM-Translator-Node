{
    "_version": "1.60.0",
    "sap.app": {
        "id": "dn.translator",
        "type": "application",
        "i18n": {
            "bundleUrl": "i18n/i18n.properties",
            "supportedLocales": [
                ""
            ],
            "fallbackLocale": ""
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "dataSources": {
            "mainService": {
                "uri": "/odata/v4/translator/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "dn.translator.view.App",
            "type": "XML",
            "id": "app"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {},
                "sap.f": {},
                "sap.tnt": {},
                "sap.ui.layout": {},
                "sap.ui.unified": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "dn.translator.i18n.i18n",
                    "supportedLocales": [
                        ""
                    ],
                    "fallbackLocale": ""
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": false,
                    "earlyRequests": true
                }
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "dn.translator.view",
                "controlId": "pageContainer",
                "controlAggregation": "pages",
                "transition": "show",
                "async": true,
                "bypassed": {
                    "target": "translate"
                }
            },
            "routes": [
                {
                    "name": "translate",
                    "pattern": "",
                    "target": "translate"
                },
                {
                    "name": "massTranslation",
                    "pattern": "mass-translation",
                    "target": "massTranslation"
                },
                {
                    "name": "testResults",
                    "pattern": "test-results:?query:",
                    "target": "testResults"
                }
            ],
            "targets": {
                "translate": {
                    "id": "translate",
                    "name": "Translate",
                    "level": 1
                },
                "massTranslation": {
                    "id": "massTranslation",
                    "name": "MassTranslation",
                    "level": 1
                },
                "testResults": {
                    "id": "testResults",
                    "name": "TestResults",
                    "level": 1
                }
            }
        }
    }
}
