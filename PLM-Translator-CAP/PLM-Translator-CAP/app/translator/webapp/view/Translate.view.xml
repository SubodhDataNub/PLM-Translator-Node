<mvc:View
    controllerName="dn.translator.controller.Translate"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    height="100%">

    <f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>singleTitle}" level="H2" wrapping="true" />
                </f:heading>
                <f:expandedContent>
                    <Text text="{view>/sessionText}" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="{view>/sessionText}" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <core:InvisibleText id="sourceLabel" text="{i18n>sourceLabel}" />
                <core:InvisibleText id="translateShortcut" text="{i18n>shortcutDescription}" />
                <core:InvisibleText id="languageLabel" text="{i18n>targetLanguage}" />
                <core:InvisibleText id="translationLabel" text="{i18n>translationLabel}" />

                <FlexBox wrap="Wrap" alignItems="Stretch" class="dnPanes">
                    <Panel class="dnPane" backgroundDesign="Solid">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="24rem" minWidth="0" />
                        </layoutData>
                        <headerToolbar>
                            <OverflowToolbar style="Clear">
                                <Title text="{i18n>sourceTitle}" level="H3" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <FlexBox id="sourceChipRow" wrap="Wrap" alignItems="Start" class="dnChipRow dnDetectedRow">
                            <ObjectStatus
                                text="{view>/detectedText}"
                                icon="{= ${view>/detected} ? 'sap-icon://accept' : '' }"
                                state="{= ${view>/detected} ? 'Information' : 'None' }"
                                inverted="{= !!${view>/detected} }" />
                        </FlexBox>

                        <TextArea
                            id="sourceText"
                            value="{view>/sourceText}"
                            valueLiveUpdate="true"
                            width="100%"
                            rows="8"
                            growing="true"
                            growingMaxLines="20"
                            maxLength="5000"
                            showExceededText="true"
                            enabled="{= !${view>/busy} }"
                            placeholder="{i18n>sourcePlaceholder}"
                            ariaLabelledBy="sourceLabel"
                            class="dnPaneText" />

                        <OverflowToolbar style="Clear" class="dnPaneFoot">
                            <Button
                                text="{i18n>clear}"
                                icon="sap-icon://decline"
                                type="Transparent"
                                enabled="{= !${view>/busy} }"
                                press=".onClear" />
                            <ToolbarSpacer />
                            <Text text="{i18n>shortcutHint}" class="dnShortcut" />
                            <Button
                                id="translateButton"
                                text="{= ${view>/busy} ? ${i18n>translating} : ${i18n>translate} }"
                                icon="sap-icon://translate"
                                type="Emphasized"
                                enabled="{view>/canTranslate}"
                                tooltip="{view>/translateHint}"
                                ariaDescribedBy="translateShortcut"
                                press=".onTranslate">
                                <layoutData>
                                    <OverflowToolbarLayoutData priority="NeverOverflow" />
                                </layoutData>
                            </Button>
                        </OverflowToolbar>
                    </Panel>

                    <Panel class="dnPane" backgroundDesign="Solid">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="24rem" minWidth="0" />
                        </layoutData>
                        <headerToolbar>
                            <OverflowToolbar style="Clear">
                                <Title text="{i18n>targetTitle}" level="H3" />
                                <ToolbarSpacer />
                                <ComboBox
                                    id="languageCombo"
                                    width="12rem"
                                    placeholder="{i18n>allLanguages}"
                                    selectedKey="{view>/targetLanguage}"
                                    items="{languages>/}"
                                    enabled="{= !${view>/busy} }"
                                    ariaLabelledBy="languageLabel">
                                    <core:ListItem key="{languages>code}" text="{languages>name}" additionalText="{languages>code}" />
                                    <layoutData>
                                        <OverflowToolbarLayoutData priority="NeverOverflow" />
                                    </layoutData>
                                </ComboBox>
                            </OverflowToolbar>
                        </headerToolbar>

                        <FlexBox id="targetChipRow" wrap="Wrap" alignItems="Center" class="dnChipRow" items="{view>/chips}">
                            <ToggleButton
                                text="{view>name}"
                                pressed="{view>pressed}"
                                icon="{= ${view>recent} ? 'sap-icon://history' : '' }"
                                tooltip="{= ${view>recent} ? ${i18n>recentLanguage} : ${view>name} }"
                                enabled="{= !${view>/busy} }"
                                press=".onChipPress"
                                class="dnChip" />
                        </FlexBox>

                        <TextArea
                            id="translatedText"
                            value="{view>/translatedText}"
                            editable="false"
                            width="100%"
                            rows="8"
                            growing="true"
                            growingMaxLines="20"
                            placeholder="{i18n>translationPlaceholder}"
                            busy="{view>/busy}"
                            busyIndicatorDelay="0"
                            ariaLabelledBy="translationLabel"
                            class="dnPaneText" />

                        <OverflowToolbar style="Clear" class="dnPaneFoot">
                            <Text text="{view>/meta}" visible="{= !!${view>/meta} }" class="dnMeta" />
                            <ToolbarSpacer />
                            <Button
                                icon="{view>/copyIcon}"
                                type="Transparent"
                                tooltip="{i18n>copy}"
                                enabled="{= !!${view>/translatedText} }"
                                press=".onCopy">
                                <layoutData>
                                    <OverflowToolbarLayoutData priority="NeverOverflow" />
                                </layoutData>
                            </Button>
                        </OverflowToolbar>
                    </Panel>
                </FlexBox>

                <MessageStrip
                    text="{view>/terminologyNote}"
                    visible="{= !!${view>/terminologyNote} }"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginTop" />

                <IconTabBar
                    id="workspace"
                    selectedKey="{view>/tab}"
                    expandable="false"
                    headerMode="Inline"
                    headerBackgroundDesign="Transparent"
                    backgroundDesign="Transparent"
                    class="sapUiSmallMarginTop dnWorkspace">
                    <items>
                        <IconTabFilter key="review" text="{i18n>tabReview}">
                            <form:SimpleForm
                                editable="true"
                                backgroundDesign="Transparent"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="2"
                                columnsXL="2">
                                <form:content>
                                    <Label text="{i18n>outcome}" required="true" labelFor="outcomeGroup" />
                                    <RadioButtonGroup
                                        id="outcomeGroup"
                                        columns="3"
                                        selectedIndex="{view>/review/outcomeIndex}"
                                        valueState="{view>/review/outcomeState}"
                                        select=".onOutcomeSelect">
                                        <RadioButton text="{i18n>outcomeSuccess}" />
                                        <RadioButton text="{i18n>outcomePartial}" />
                                        <RadioButton text="{i18n>outcomeFailed}" />
                                    </RadioButtonGroup>

                                    <Label text="{view>/review/accuracyLabel}" required="{view>/review/accuracyRequired}" labelFor="accuracy" />
                                    <Input
                                        id="accuracy"
                                        type="Number"
                                        value="{view>/review/accuracy}"
                                        valueLiveUpdate="true"
                                        description="%"
                                        placeholder="0–100"
                                        enabled="{view>/review/accuracyRequired}"
                                        valueState="{view>/review/accuracyState}"
                                        valueStateText="{view>/review/accuracyStateText}">
                                        <layoutData>
                                            <form:ColumnElementData cellsSmall="12" cellsLarge="12" />
                                        </layoutData>
                                    </Input>
                                    <ProgressIndicator
                                        percentValue="{view>/review/accuracyPercent}"
                                        showValue="false"
                                        height="0.375rem"
                                        state="None"
                                        class="dnAccuracyBar">
                                        <layoutData>
                                            <form:ColumnElementData cellsSmall="12" cellsLarge="12" />
                                        </layoutData>
                                    </ProgressIndicator>

                                    <Label text="{i18n>testedBy}" required="true" labelFor="testedBy" />
                                    <Input
                                        id="testedBy"
                                        value="{view>/review/testedBy}"
                                        editable="{= !${user>/user} }"
                                        valueLiveUpdate="true"
                                        maxLength="100"
                                        placeholder="{i18n>testedByPlaceholder}"
                                        valueState="{view>/review/testedByState}"
                                        valueStateText="{i18n>testedByRequired}" />

                                    <Label text="{i18n>observation}" labelFor="observation" />
                                    <TextArea
                                        id="observation"
                                        value="{view>/review/observation}"
                                        valueLiveUpdate="true"
                                        rows="3"
                                        width="100%"
                                        maxLength="500"
                                        showExceededText="true"
                                        placeholder="{i18n>observationPlaceholder}" />
                                </form:content>
                            </form:SimpleForm>

                            <OverflowToolbar style="Clear" class="dnReviewActions">
                                <ToolbarSpacer />
                                <Button
                                    text="{= ${view>/review/saving} ? ${i18n>saving} : ${i18n>saveResult} }"
                                    icon="sap-icon://save"
                                    type="Emphasized"
                                    enabled="{view>/review/canSave}"
                                    tooltip="{view>/review/saveHint}"
                                    press=".onSaveReview" />
                            </OverflowToolbar>
                        </IconTabFilter>

                        <IconTabFilter key="recent" text="{i18n>tabRecent}" count="{view>/historyCount}">
                            <List items="{view>/history}" backgroundDesign="Transparent" noDataText="{i18n>historyEmpty}">
                                <StandardListItem
                                    title="{view>sourceText}"
                                    description="{view>translatedText}"
                                    info="{view>route}"
                                    infoState="Information"
                                    type="Active"
                                    tooltip="{i18n>historyLoad}"
                                    press=".onHistoryPress" />
                            </List>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
