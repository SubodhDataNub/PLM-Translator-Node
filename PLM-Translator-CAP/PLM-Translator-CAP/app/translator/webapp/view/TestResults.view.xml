<mvc:View
    controllerName="dn.translator.controller.TestResults"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m"
    height="100%">

    <f:DynamicPage id="page" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>resultsPageTitle}" level="H2" wrapping="true" />
                </f:heading>
                <f:expandedContent>
                    <Text text="{i18n>resultsLede}" />
                </f:expandedContent>
                <f:snappedContent>
                    <Text text="{view>/statsSummary}" />
                </f:snappedContent>
                <f:actions>
                    <Button text="{i18n>refresh}" icon="sap-icon://refresh" press=".onRefresh" />
                    <Button
                        text="{i18n>exportExcel}"
                        icon="sap-icon://excel-attachment"
                        type="Emphasized"
                        enabled="{= !${view>/exporting} }"
                        press=".onExport" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <VBox>
                    <FlexBox wrap="Wrap" class="dnKpiRow">
                        <VBox class="dnKpi">
                            <Label text="{view>/totalLabel}" />
                            <ObjectNumber number="{view>/stats/total}" class="dnKpiValue" />
                        </VBox>
                        <VBox class="dnKpi">
                            <Label text="{i18n>kpiSuccessful}" />
                            <ObjectNumber number="{view>/stats/success}" state="Success" class="dnKpiValue" />
                        </VBox>
                        <VBox class="dnKpi">
                            <Label text="{i18n>kpiPartial}" />
                            <ObjectNumber number="{view>/stats/partial}" state="Warning" class="dnKpiValue" />
                        </VBox>
                        <VBox class="dnKpi">
                            <Label text="{i18n>kpiFailed}" />
                            <ObjectNumber number="{view>/stats/failed}" state="Error" class="dnKpiValue" />
                        </VBox>
                        <VBox class="dnKpi">
                            <Label text="{i18n>kpiSuccessRate}" />
                            <ObjectNumber number="{view>/stats/successRate}" unit="%" class="dnKpiValue" />
                        </VBox>
                    </FlexBox>

                    <FlexBox wrap="Wrap" alignItems="End" class="dnFilterBar sapUiSmallMarginTop">
                        <VBox class="dnFilterField dnFilterSearch">
                            <Label text="{i18n>search}" labelFor="searchField" />
                            <SearchField
                                id="searchField"
                                width="100%"
                                value="{view>/search}"
                                placeholder="{i18n>searchPlaceholder}"
                                search=".onSearch" />
                        </VBox>
                        <VBox class="dnFilterField">
                            <Label text="{i18n>outcome}" labelFor="outcomeFilter" />
                            <Select id="outcomeFilter" width="100%" selectedKey="{view>/outcome}" change=".onFilterChange">
                                <core:Item key="" text="{i18n>allOutcomes}" />
                                <core:Item key="Success" text="{i18n>outcomeSuccess}" />
                                <core:Item key="Partial" text="{i18n>outcomePartial}" />
                                <core:Item key="Failed" text="{i18n>outcomeFailed}" />
                            </Select>
                        </VBox>
                        <VBox class="dnFilterField">
                            <Label text="{i18n>language}" labelFor="languageFilter" />
                            <Select
                                id="languageFilter"
                                width="100%"
                                selectedKey="{view>/language}"
                                items="{view>/languages}"
                                change=".onFilterChange">
                                <core:Item key="{view>key}" text="{view>text}" />
                            </Select>
                        </VBox>
                        <VBox class="dnFilterField">
                            <Label text="{i18n>sort}" labelFor="sortSelect" />
                            <Select id="sortSelect" width="100%" selectedKey="{view>/sort}" change=".onFilterChange">
                                <core:Item key="id_desc" text="{i18n>sortIdDesc}" />
                                <core:Item key="id_asc" text="{i18n>sortIdAsc}" />
                                <core:Item key="created_at_desc" text="{i18n>sortDateDesc}" />
                                <core:Item key="created_at_asc" text="{i18n>sortDateAsc}" />
                                <core:Item key="accuracy_desc" text="{i18n>sortAccuracyDesc}" />
                                <core:Item key="accuracy_asc" text="{i18n>sortAccuracyAsc}" />
                            </Select>
                        </VBox>
                        <Button
                            text="{i18n>clearFilters}"
                            icon="sap-icon://clear-filter"
                            type="Transparent"
                            press=".onClearFilters"
                            class="dnFilterField" />
                    </FlexBox>
                </VBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="resultsTable"
                growing="true"
                growingThreshold="50"
                growingScrollToLoad="false"
                sticky="HeaderToolbar,ColumnHeaders"
                popinLayout="GridSmall"
                class="dnResultsTable">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{view>/tableTitle}" level="H3" />
                        <ToolbarSpacer />
                        <Link
                            text="{i18n>odataJson}"
                            href="/odata/v4/translator/TestResults?$top=50&amp;$orderby=ID%20desc"
                            target="_blank" />
                    </OverflowToolbar>
                </headerToolbar>

                <noData>
                    <IllustratedMessage
                        illustrationType="{= ${view>/filtered} ? 'sapIllus-NoFilterResults' : 'sapIllus-EmptyList' }"
                        title="{= ${view>/filtered} ? ${i18n>noMatchTitle} : ${i18n>noResultsTitle} }"
                        description="{= ${view>/filtered} ? ${i18n>noMatchText} : ${i18n>noResultsText} }"
                        enableVerticalResponsiveness="true">
                        <additionalContent>
                            <Button text="{i18n>clearFilters}" icon="sap-icon://clear-filter" visible="{view>/filtered}" press=".onClearFilters" />
                            <Button text="{i18n>navSingle}" icon="sap-icon://translate" type="Emphasized" visible="{= !${view>/filtered} }" press=".onGoTranslate" />
                            <Button text="{i18n>navMass}" icon="sap-icon://excel-attachment" visible="{= !${view>/filtered} }" press=".onGoMass" />
                        </additionalContent>
                    </IllustratedMessage>
                </noData>

                <columns>
                    <Column width="5rem">
                        <Text text="{i18n>colId}" />
                    </Column>
                    <Column width="8rem">
                        <Text text="{i18n>colStatus}" />
                    </Column>
                    <Column width="10rem" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colAccuracy}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colTestedBy}" />
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>colLanguage}" />
                    </Column>
                    <Column width="30%" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>colObservation}" />
                    </Column>
                    <Column width="9rem" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>colCreated}" />
                    </Column>
                </columns>
            </Table>
        </f:content>

        <f:dependents>
            <ColumnListItem
                id="rowTemplate"
                type="Navigation"
                press=".onRowPress"
                highlight="{path: 'outcome', formatter: '.formatter.outcomeState'}">
                <cells>
                    <ObjectIdentifier title="#{path: 'ID', targetType: 'any'}" />
                    <ObjectStatus
                        text="{path: 'outcome', formatter: '.formatter.outcomeText'}"
                        state="{path: 'outcome', formatter: '.formatter.outcomeState'}"
                        icon="{path: 'outcome', formatter: '.formatter.outcomeIcon'}" />
                    <VBox>
                        <ProgressIndicator
                            visible="{path: 'accuracy', targetType: 'any', formatter: '.formatter.hasAccuracy'}"
                            percentValue="{path: 'accuracy', targetType: 'any', formatter: '.formatter.accuracyPercent'}"
                            displayValue="{path: 'accuracy', targetType: 'any', formatter: '.formatter.accuracyText'}"
                            state="{path: 'accuracy', targetType: 'any', formatter: '.formatter.accuracyState'}"
                            displayOnly="true"
                            class="dnTableAccuracy" />
                        <Text text="–" visible="{path: 'accuracy', targetType: 'any', formatter: '.formatter.noAccuracy'}" />
                    </VBox>
                    <Text text="{path: 'testedBy', formatter: '.formatter.orDash'}" wrapping="false" tooltip="{testedBy}" />
                    <Text text="{path: 'targetLanguage', formatter: '.formatter.orDash'}" class="dnMono" />
                    <Text text="{= ${observation} || ${i18n>noObservation} }" maxLines="2" tooltip="{observation}" />
                    <Text text="{path: 'createdAt', targetType: 'any', formatter: '.formatter.createdUtc'}" class="dnMono" />
                </cells>
            </ColumnListItem>
        </f:dependents>
    </f:DynamicPage>
</mvc:View>
