<mvc:View
    controllerName="dn.translator.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    displayBlock="true"
    height="100%">

    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader>
                <Button
                    icon="sap-icon://menu2"
                    type="Transparent"
                    tooltip="{i18n>navToggle}"
                    press=".onSideNavToggle">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow" />
                    </layoutData>
                </Button>
                <Title text="{i18n>productName}" level="H1" class="dnBrandName">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow" />
                    </layoutData>
                </Title>
                <ToolbarSpacer />
                <Button
                    id="themeButton"
                    icon="sap-icon://palette"
                    type="Transparent"
                    tooltip="{i18n>themeTitle}"
                    press=".onThemeMenu">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow" />
                    </layoutData>
                </Button>
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNavigation"
                selectedKey="{app>/selectedKey}"
                itemSelect=".onNavItemSelect"
                ariaLabel="{i18n>navLabel}">
                <tnt:NavigationList>
                    <tnt:NavigationListItem key="translate" text="{i18n>navSingle}" icon="sap-icon://translate" />
                    <tnt:NavigationListItem key="massTranslation" text="{i18n>navMass}" icon="sap-icon://excel-attachment" />
                    <tnt:NavigationListItem key="testResults" text="{i18n>navResults}" icon="sap-icon://checklist-2" />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <NavContainer id="pageContainer" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
