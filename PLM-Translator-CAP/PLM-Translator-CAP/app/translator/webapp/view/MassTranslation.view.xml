<mvc:View
    controllerName="dn.translator.controller.MassTranslation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns="sap.m"
    height="100%">

    <f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>massTitle}" level="H2" wrapping="true" />
                </f:heading>
                <f:expandedContent>
                    <Text text="{i18n>massLede}" />
                </f:expandedContent>
                <f:actions>
                    <Button
                        text="{i18n>downloadTemplate}"
                        icon="sap-icon://download"
                        press=".onDownloadTemplate" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <l:Grid hSpacing="1" vSpacing="0">
                    <VBox>
                        <layoutData>
                            <l:GridData span="XL8 L8 M12 S12" />
                        </layoutData>

                        <Panel id="filePanel" headerText="{i18n>stepFile}" backgroundDesign="Solid" class="dnDropZone sapUiSmallMarginBottom">
                            <Text text="{i18n>fileHint}" class="sapUiSmallMarginBottom" />
                            <u:FileUploader
                                id="fileUploader"
                                width="100%"
                                fileType="xlsx,xls"
                                buttonText="{i18n>browse}"
                                placeholder="{i18n>filePlaceholder}"
                                sameFilenameAllowed="true"
                                change=".onFileChange"
                                typeMissmatch=".onTypeMismatch"
                                enabled="{= !${view>/running} }" />
                            <Text text="{view>/fileSize}" visible="{view>/hasFile}" class="dnMeta sapUiTinyMarginTop" />

                            <VBox visible="{view>/hasFile}" class="sapUiSmallMarginTop">
                                <MessageStrip
                                    text="{view>/largeFileText}"
                                    visible="{view>/largeFile}"
                                    type="Warning"
                                    showIcon="true"
                                    class="sapUiSmallMarginBottom" />

                                <l:Grid defaultSpan="XL6 L6 M6 S12" hSpacing="1" vSpacing="0">
                                    <VBox>
                                        <Title text="{i18n>fileDetails}" level="H4" />
                                        <Text text="{i18n>validateFirst}" visible="{= !${view>/validation} }" class="dnMuted sapUiTinyMarginTop" />
                                        <form:SimpleForm
                                            visible="{= !!${view>/validation} }"
                                            editable="false"
                                            layout="ResponsiveGridLayout"
                                            labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12"
                                            columnsXL="1" columnsL="1" columnsM="1"
                                            singleContainerFullSize="true">
                                            <form:content>
                                                <Label text="{i18n>fileSizeLabel}" />
                                                <Text text="{view>/validation/fileSize}" />
                                                <Label text="{i18n>totalRows}" />
                                                <Text text="{view>/validation/totalRows}" />
                                                <Label text="{i18n>textColumn}" />
                                                <Text text="{view>/validation/textColumn}" />
                                                <Label text="{i18n>columns}" />
                                                <Text text="{view>/validation/columns}" />
                                            </form:content>
                                        </form:SimpleForm>
                                    </VBox>

                                    <VBox>
                                        <Title text="{i18n>estimate}" level="H4" />
                                        <Text text="{i18n>estimateFirst}" visible="{= !${view>/validation} }" class="dnMuted sapUiTinyMarginTop" />
                                        <form:SimpleForm
                                            visible="{= !!${view>/validation} &amp;&amp; !${view>/estimate} }"
                                            editable="false"
                                            layout="ResponsiveGridLayout"
                                            labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12"
                                            columnsXL="1" columnsL="1" columnsM="1"
                                            singleContainerFullSize="true">
                                            <form:content>
                                                <Label text="{i18n>baseEstimate}" />
                                                <Text text="{view>/validation/baseEstimate}" />
                                                <Label text="{i18n>recordCount}" />
                                                <Text text="{view>/validation/recordCount}" />
                                            </form:content>
                                        </form:SimpleForm>
                                        <Text
                                            text="{i18n>pickLanguagesForEstimate}"
                                            visible="{= !!${view>/validation} &amp;&amp; !${view>/estimate} }"
                                            class="dnMuted" />
                                        <form:SimpleForm
                                            visible="{= !!${view>/estimate} }"
                                            editable="false"
                                            layout="ResponsiveGridLayout"
                                            labelSpanXL="5" labelSpanL="5" labelSpanM="5" labelSpanS="12"
                                            columnsXL="1" columnsL="1" columnsM="1"
                                            singleContainerFullSize="true">
                                            <form:content>
                                                <Label text="{i18n>estimatedTime}" />
                                                <Text text="{view>/estimate/time}" />
                                                <Label text="{i18n>languagesSelected}" />
                                                <Text text="{view>/estimate/languages}" />
                                                <Label text="{i18n>totalTranslations}" />
                                                <Text text="{view>/estimate/total}" />
                                            </form:content>
                                        </form:SimpleForm>
                                        <Text text="{view>/estimate/recommendation}" visible="{= !!${view>/estimate/recommendation} }" class="dnMuted" />
                                        <VBox items="{view>/recommendations}" visible="{= ${view>/recommendations}.length > 0 }" class="sapUiTinyMarginTop">
                                            <Text text="• {view>}" class="dnMuted" />
                                        </VBox>
                                    </VBox>
                                </l:Grid>

                                <Button
                                    text="{= ${view>/validating} ? ${i18n>validating} : ${i18n>validateFile} }"
                                    icon="sap-icon://inspection"
                                    enabled="{= !${view>/validating} &amp;&amp; !${view>/running} }"
                                    press=".onValidate"
                                    class="sapUiSmallMarginTop" />
                            </VBox>
                        </Panel>

                        <Panel backgroundDesign="Solid" class="sapUiSmallMarginBottom">
                            <headerToolbar>
                                <OverflowToolbar style="Clear">
                                    <Title text="{i18n>stepLanguages}" level="H3" />
                                    <ObjectStatus text="{view>/selectedText}" state="{view>/selectedState}" inverted="true" class="sapUiTinyMarginBegin" />
                                    <ToolbarSpacer />
                                    <Button text="{i18n>common}" icon="sap-icon://favorite" tooltip="{i18n>commonTooltip}" press=".onSelectCommon" />
                                    <Button text="{i18n>clearSelection}" icon="sap-icon://decline" press=".onClearLanguages" />
                                </OverflowToolbar>
                            </headerToolbar>

                            <SearchField
                                width="100%"
                                placeholder="{i18n>searchLanguages}"
                                liveChange=".onLanguageSearch"
                                search=".onLanguageSearch"
                                class="sapUiSmallMarginBottom" />
                            <ScrollContainer height="22rem" vertical="true" horizontal="false">
                                <Table
                                    id="languageTable"
                                    mode="MultiSelect"
                                    items="{lang>/}"
                                    sticky="ColumnHeaders"
                                    noDataText="{i18n>noLanguagesFound}"
                                    selectionChange=".onLanguageSelectionChange">
                                    <columns>
                                        <Column>
                                            <Text text="{i18n>language}" />
                                        </Column>
                                        <Column hAlign="End" width="8rem">
                                            <Text text="{i18n>code}" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem selected="{lang>selected}">
                                            <cells>
                                                <Text text="{lang>name}" />
                                                <Text text="{lang>code}" class="dnMono" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </ScrollContainer>
                            <Text text="{i18n>commonNote}" class="dnMuted sapUiSmallMarginTop" />
                        </Panel>
                    </VBox>

                    <VBox>
                        <layoutData>
                            <l:GridData span="XL4 L4 M12 S12" />
                        </layoutData>

                        <Panel headerText="{i18n>stepRun}" backgroundDesign="Solid" class="sapUiSmallMarginBottom">
                            <Label text="{i18n>testedBy}" required="true" labelFor="massTestedBy" />
                            <Input
                                id="massTestedBy"
                                value="{view>/testedBy}"
                                valueLiveUpdate="true"
                                maxLength="100"
                                placeholder="{i18n>testedByMassPlaceholder}"
                                valueState="{view>/testedByState}"
                                valueStateText="{i18n>testedByRequiredMass}"
                                liveChange=".onTestedByChange" />
                            <Text text="{i18n>testedByMassHint}" class="dnMuted sapUiTinyMarginTop" />
                            <Button
                                text="{i18n>startMass}"
                                icon="sap-icon://play"
                                type="Emphasized"
                                width="100%"
                                enabled="{= !${view>/running} }"
                                press=".onStart"
                                class="sapUiMediumMarginTop" />
                            <Text text="{i18n>keepTabOpen}" class="dnMuted sapUiSmallMarginTop" />
                        </Panel>

                        <Panel headerText="{i18n>guideTitle}" backgroundDesign="Solid">
                            <List showSeparators="None" backgroundDesign="Transparent">
                                <StandardListItem icon="sap-icon://excel-attachment" title="{i18n>guideFile}" wrapping="true" />
                                <StandardListItem icon="sap-icon://world" title="{i18n>guideLanguages}" wrapping="true" />
                                <StandardListItem icon="sap-icon://fob-watch" title="{i18n>guideTime}" wrapping="true" />
                            </List>
                        </Panel>
                    </VBox>

                    <Panel id="resultsPanel" visible="{= !!${view>/result} }" backgroundDesign="Solid" class="sapUiSmallMarginTop">
                        <layoutData>
                            <l:GridData span="XL12 L12 M12 S12" />
                        </layoutData>
                        <headerToolbar>
                            <OverflowToolbar style="Clear">
                                <Title text="{i18n>resultsTitle}" level="H3" />
                                <ToolbarSpacer />
                                <Button
                                    text="{i18n>downloadResults}"
                                    icon="sap-icon://download"
                                    type="Emphasized"
                                    press=".onDownloadResults" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <FlexBox wrap="Wrap" class="dnKpiRow">
                            <VBox class="dnKpi">
                                <Label text="{i18n>kpiRows}" />
                                <ObjectNumber number="{view>/result/totalRows}" class="dnKpiValue" />
                            </VBox>
                            <VBox class="dnKpi">
                                <Label text="{i18n>kpiSuccessful}" />
                                <ObjectNumber number="{view>/result/successful}" state="Success" class="dnKpiValue" />
                            </VBox>
                            <VBox class="dnKpi">
                                <Label text="{i18n>kpiFailed}" />
                                <ObjectNumber number="{view>/result/failed}" state="{= ${view>/result/failedCount} > 0 ? 'Error' : 'None' }" class="dnKpiValue" />
                            </VBox>
                            <VBox class="dnKpi">
                                <Label text="{i18n>kpiSuccessRate}" />
                                <ObjectNumber number="{view>/result/successRate}" unit="%" class="dnKpiValue" />
                            </VBox>
                        </FlexBox>
                        <Text text="{i18n>countsNote}" class="dnMuted sapUiTinyMarginTop" />

                        <MessageStrip
                            text="{view>/result/message}"
                            type="Success"
                            showIcon="true"
                            class="sapUiSmallMarginTop">
                            <link>
                                <Link text="{i18n>openTestResults}" press=".onOpenResults" />
                            </link>
                        </MessageStrip>
                        <Text
                            text="{view>/result/labelTypes}"
                            visible="{= !!${view>/result/labelTypes} }"
                            class="dnMuted sapUiSmallMarginTop" />
                    </Panel>
                </l:Grid>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
