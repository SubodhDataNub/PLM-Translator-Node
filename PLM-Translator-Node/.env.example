# ---------------------------------------------------------------------------
# DN Translator (Node.js) - environment configuration
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# Server
PORT=5000
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Google Cloud Translation API
# Configure one of the two options below. If both are set, Option A is used.
# ---------------------------------------------------------------------------

# Option A (recommended) - Cloud Translation Advanced (v3), Translation LLM by default
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# Credentials: if you ran `gcloud auth application-default login`, nothing more is needed here.
# Otherwise point to a service account key file...
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# ...or paste the key JSON inline (useful for Azure App Service settings)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Model (default general/translation-llm); set general/nmt to use the standard model
# GOOGLE_TRANSLATE_MODEL=general/translation-llm

# Option B - Cloud Translation Basic (v2) with an API key (standard model only, no LLM)
# GOOGLE_TRANSLATE_API_KEY=your-api-key

# Batching / rate limiting
# TRANSLATE_BATCH_SIZE=25                 # texts per API request for mass translation
# TRANSLATE_MAX_CHARS_PER_REQUEST=5000    # Google recommends <= 5,000 characters per request
# TRANSLATE_REQUEST_DELAY_MS=250          # pause between batch requests
# TRANSLATE_MAX_RETRIES=5                 # attempts per batch on rate limit (429 / RESOURCE_EXHAUSTED)

# ---------------------------------------------------------------------------
# Database
# Development defaults to SQLite at data/plm_translator.db when nothing is set.
# ---------------------------------------------------------------------------

# SQLite
# DATABASE_TYPE=sqlite
# SQLITE_PATH=data/plm_translator.db

# Azure SQL Database
# AZURE_SQL_SERVER=yourserver.database.windows.net
# AZURE_SQL_DATABASE=yourdatabase
# AZURE_SQL_USERNAME=youruser
# AZURE_SQL_PASSWORD=yourpassword

# Or a single URL / connection string (sqlite:///data/app.db, mssql://user:pass@host/db,
# or an ADO.NET "Server=...;Initial Catalog=...;User ID=...;Password=..." string)
# DATABASE_URL=

# ---------------------------------------------------------------------------
# Large-scale processing
# ---------------------------------------------------------------------------
# LST_CHUNK_SIZE=1000
# LST_MAX_WORKERS=10
# LST_BATCH_SIZE=25
# LST_MAX_RETRIES=3
# MAX_UPLOAD_MB=200
